{
  "name": "@jhonhtipas21/sdkify",
  "version": "1.0.0",
  "description": "SDKify — Generates TypeScript SDKs from OpenAPI specifications using AI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sdkify": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "validate-spec": "node -e \"import('./dist/validators/swagger.validator.js').then(m => new m.SwaggerSpecValidator().validate('tests/fixtures/petstore.yaml').then(() => { console.log('Spec OK'); process.exit(0); }).catch(e => { console.error(e.message); process.exit(1); }));\"",
    "start": "ts-node src/index.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "openapi",
    "swagger",
    "sdk",
    "generator",
    "typescript",
    "hey-api",
    "ai",
    "groq"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@hey-api/client-fetch": "^0.2.0",
    "@hey-api/openapi-ts": "^0.53.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "groq-sdk": "^0.5.0",
    "ts-morph": "^22.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^20.12.12",
    "msw": "^2.3.0",
    "semantic-release": "^25.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
